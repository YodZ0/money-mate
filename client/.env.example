# Copy to .env.local and fill in your own values.
# Variables prefixed with VITE_ are embedded into the client bundle at build
# time, so never put secrets in them.

# Base API URL. A relative path goes through a proxy (the Vite dev server
# or nginx in production); an absolute URL hits the backend directly.
VITE_API_BASE_URL=/api/v1

# Application name (login page heading, sidebar).
VITE_APP_NAME=Money Mate

# Verbose logger.debug output in dev mode.
VITE_ENABLE_DEBUG=false

# Dev server only: where to proxy /api. Not included in the bundle.
API_PROXY_TARGET=http://localhost:8000
